@model HotelSuite.Application.DTOs.HabitacionDTO

<div class="card habitacion-card h-100 shadow-sm">
    <div class="card-body">
  <div class="d-flex justify-content-between align-items-start mb-3">
      <div>
  <h5 class="card-title mb-1">
           <i class="fas fa-door-open me-2 text-primary"></i>
       Habitación @Model.Numero
          </h5>
     <span class="badge bg-info">@Model.Tipo</span>
      </div>
        <div class="text-end">
   <h4 class="text-primary mb-0">@Model.PrecioPorNoche.ToString("C")</h4>
<small class="text-muted">por noche</small>
  </div>
  </div>

  <div class="habitacion-details mb-3">
            <div class="detail-item">
     <i class="fas fa-hotel me-2 text-muted"></i>
    <span class="text-muted">Hotel:</span>
   <strong>@Model.NombreHotel</strong>
      </div>
       <div class="detail-item mt-2">
       <i class="fas fa-info-circle me-2 text-muted"></i>
      <span class="text-muted">Estado:</span>
   @switch (Model.Estado)
 {
       case "Disponible":
   <span class="badge bg-success">
 <i class="fas fa-check-circle me-1"></i>Disponible
        </span>
       break;
 case "Ocupada":
         <span class="badge bg-danger">
<i class="fas fa-user me-1"></i>Ocupada
     </span>
     break;
         case "Mantenimiento":
     <span class="badge bg-warning text-dark">
     <i class="fas fa-tools me-1"></i>Mantenimiento
    </span>
  break;
    case "Reservada":
    <span class="badge bg-info">
    <i class="fas fa-calendar-check me-1"></i>Reservada
       </span>
     break;
     default:
   <span class="badge bg-secondary">@Model.Estado</span>
          break;
   }
   </div>
    </div>

  <div class="d-grid gap-2">
        @if (User.Identity?.IsAuthenticated == true)
        {
     @if (User.IsInRole("Administrador") || User.IsInRole("Gerente") || User.IsInRole("Recepcionista"))
            {
         <a asp-controller="Habitaciones" asp-action="Details" asp-route-id="@Model.Id" 
     class="btn btn-outline-primary btn-sm">
  <i class="fas fa-eye me-1"></i>Ver Detalles
     </a>

          if (Model.Estado == "Disponible")
      {
 <a asp-controller="Reservas" asp-action="Create" asp-route-habitacionId="@Model.Id" 
     class="btn btn-success btn-sm">
       <i class="fas fa-calendar-plus me-1"></i>Reservar
 </a>
        }
     }
        }
        else
      {
      <a asp-controller="Habitaciones" asp-action="Details" asp-route-id="@Model.Id" 
  class="btn btn-outline-primary btn-sm">
      <i class="fas fa-eye me-1"></i>Ver Detalles
    </a>
        }
  </div>
    </div>

 @if (Model.Estado == "Disponible")
    {
  <div class="card-footer bg-success bg-opacity-10 border-success">
         <small class="text-success">
 <i class="fas fa-check-circle me-1"></i>Disponible para reservar
</small>
      </div>
  }
</div>

<style>
    .habitacion-card {
        transition: all 0.3s;
        border-radius: 12px;
        overflow: hidden;
 }

    .habitacion-card:hover {
 transform: translateY(-5px);
   box-shadow: 0 10px 25px rgba(0,0,0,0.15) !important;
  }

 .detail-item {
   display: flex;
        align-items: center;
    }

    .card-footer {
  text-align: center;
        padding: 10px;
    }
</style>
