@model X.PagedList.IPagedList<HotelSuite.Application.DTOs.HuespedDTO>

@{
    ViewData["Title"] = "Gestión de Huéspedes";
}

<div class="container py-4">
    <!-- Encabezado -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body bg-gradient text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <div class="d-flex justify-content-between align-items-center">
        <div>
   <h3 class="mb-1">
        <i class="fas fa-users me-2"></i>Gestión de Huéspedes
  </h3>
          <p class="mb-0 opacity-75">Administre la información de los huéspedes del hotel</p>
  </div>
         <div>
           <a asp-action="Create" class="btn btn-light btn-lg">
  <i class="fas fa-user-plus me-2"></i>Nuevo Huésped
       </a>
         </div>
  </div>
        </div>
    </div>

    <!-- Búsqueda y Filtros -->
    <div class="card border-0 shadow-sm mb-4">
     <div class="card-body">
            <form asp-action="Index" method="get" class="row g-3">
        <div class="col-md-10">
             <div class="input-group input-group-lg">
        <span class="input-group-text bg-white">
     <i class="fas fa-search text-muted"></i>
      </span>
           <input type="text" name="busqueda" class="form-control" 
      placeholder="Buscar por nombre, email o documento..." 
   value="@ViewBag.Busqueda" />
        </div>
   </div>
     <div class="col-md-2">
     <button type="submit" class="btn btn-primary btn-lg w-100">
    <i class="fas fa-search me-2"></i>Buscar
     </button>
        </div>
            </form>
        </div>
    </div>

    <!-- Tabla de Huéspedes -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-light">
<div class="d-flex justify-content-between align-items-center">
 <h5 class="mb-0">
 <i class="fas fa-list me-2 text-primary"></i>Listado de Huéspedes
       </h5>
             <span class="badge bg-primary fs-6">Total: @Model.TotalItemCount</span>
        </div>
        </div>
  <div class="card-body p-0">
            @if (Model.Any())
        {
   <div class="table-responsive">
         <table class="table table-hover mb-0">
     <thead class="table-light">
       <tr>
                <th><i class="fas fa-hashtag me-1"></i>ID</th>
          <th><i class="fas fa-user me-1"></i>Nombre Completo</th>
            <th><i class="fas fa-envelope me-1"></i>Email</th>
   <th><i class="fas fa-phone me-1"></i>Teléfono</th>
       <th><i class="fas fa-id-card me-1"></i>Documento</th>
   <th class="text-center"><i class="fas fa-cogs me-1"></i>Acciones</th>
       </tr>
   </thead>
            <tbody>
        @foreach (var huesped in Model)
      {
       <tr>
        <td class="align-middle">
      <span class="badge bg-secondary">#@huesped.Id</span>
  </td>
     <td class="align-middle">
  <div class="d-flex align-items-center">
        <div class="avatar-circle bg-primary text-white me-2">
    @huesped.Nombres.Substring(0, 1).ToUpper()
     </div>
  <strong>@huesped.NombreCompleto</strong>
               </div>
         </td>
        <td class="align-middle">
          <i class="fas fa-envelope text-muted me-1"></i>
      <a href="mailto:@huesped.Email">@huesped.Email</a>
         </td>
       <td class="align-middle">
   <i class="fas fa-phone text-muted me-1"></i>
   @huesped.Telefono
          </td>
       <td class="align-middle">
    <code>@huesped.DocumentoIdentidad</code>
         </td>
     <td class="align-middle text-center">
      <div class="btn-group" role="group">
               <a asp-action="Details" asp-route-id="@huesped.Id" 
  class="btn btn-sm btn-outline-info" title="Ver detalles">
<i class="fas fa-eye"></i>
         </a>
      <a asp-action="Edit" asp-route-id="@huesped.Id" 
        class="btn btn-sm btn-outline-warning" title="Editar">
 <i class="fas fa-edit"></i>
         </a>
       <a asp-action="Delete" asp-route-id="@huesped.Id" 
        class="btn btn-sm btn-outline-danger" title="Eliminar">
        <i class="fas fa-trash"></i>
     </a>
   </div>
 </td>
    </tr>
         }
   </tbody>
     </table>
                </div>

     <!-- Paginación -->
          @if (Model.PageCount > 1)
     {
  <div class="card-footer bg-light">
          <div class="d-flex justify-content-between align-items-center">
             <div>
        Mostrando @Model.FirstItemOnPage - @Model.LastItemOnPage de @Model.TotalItemCount huéspedes
   </div>
         <nav>
 <ul class="pagination pagination-sm mb-0">
       @if (Model.HasPreviousPage)
      {
          <li class="page-item">
      <a class="page-link" asp-action="Index" asp-route-pagina="@(Model.PageNumber - 1)" asp-route-busqueda="@ViewBag.Busqueda">
          <i class="fas fa-chevron-left"></i>
      </a>
              </li>
        }

   @for (int i = 1; i <= Model.PageCount; i++)
  {
          <li class="page-item @(i == Model.PageNumber ? "active" : "")">
   <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-busqueda="@ViewBag.Busqueda">@i</a>
        </li>
     }

    @if (Model.HasNextPage)
{
          <li class="page-item">
           <a class="page-link" asp-action="Index" asp-route-pagina="@(Model.PageNumber + 1)" asp-route-busqueda="@ViewBag.Busqueda">
       <i class="fas fa-chevron-right"></i>
           </a>
       </li>
          }
              </ul>
        </nav>
    </div>
 </div>
          }
 }
            else
         {
      <div class="text-center py-5">
        <i class="fas fa-users fa-5x text-muted mb-3"></i>
      <h4 class="text-muted">No se encontraron huéspedes</h4>
                 @if (!string.IsNullOrWhiteSpace(ViewBag.Busqueda as string))
        {
            <p class="text-muted">No hay resultados para: <strong>@ViewBag.Busqueda</strong></p>
            <a asp-action="Index" class="btn btn-primary">
        <i class="fas fa-redo me-2"></i>Ver Todos
      </a>
         }
       else
         {
     <p class="text-muted mb-3">Comience registrando un nuevo huésped</p>
        <a asp-action="Create" class="btn btn-primary btn-lg">
        <i class="fas fa-user-plus me-2"></i>Registrar Primer Huésped
   </a>
          }
      </div>
 }
 </div>
    </div>
</div>

<style>
    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
     align-items: center;
        justify-content: center;
     font-weight: bold;
  font-size: 1.1rem;
    }

    .btn-group .btn {
        border-radius: 0;
    }

    .btn-group .btn:first-child {
        border-top-left-radius: 0.25rem;
        border-bottom-left-radius: 0.25rem;
    }

    .btn-group .btn:last-child {
    border-top-right-radius: 0.25rem;
border-bottom-right-radius: 0.25rem;
  }
</style>
