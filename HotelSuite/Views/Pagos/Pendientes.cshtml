@model X.PagedList.IPagedList<HotelSuite.Application.DTOs.PagoDTO>
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Pagos Pendientes";
}

<div class="container-fluid py-4">
    <!-- Encabezado -->
<div class="row mb-4">
        <div class="col-12">
   <div class="card border-0 shadow-sm">
  <div class="card-body bg-gradient" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
 <div class="d-flex justify-content-between align-items-center">
   <div class="text-white">
     <h2 class="mb-1">
    <i class="fas fa-clock me-2"></i>Pagos Pendientes
     </h2>
  <p class="mb-0 opacity-75">Pagos que requieren atención</p>
         </div>
        <a asp-action="Index" class="btn btn-light btn-lg shadow-sm">
      <i class="fas fa-list me-2"></i>Ver Todos
   </a>
      </div>
   </div>
        </div>
        </div>
    </div>

    <!-- Mensajes -->
    @if (TempData["Success"] != null)
    {
 <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
    <i class="fas fa-check-circle me-2"></i>
       @TempData["Success"]
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
 </div>
    }

    @if (TempData["Error"] != null)
    {
 <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
       <i class="fas fa-exclamation-circle me-2"></i>
       @TempData["Error"]
     <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
 </div>
    }

    <!-- Resumen -->
    @if (Model != null && Model.Any())
    {
 <div class="row mb-4">
     <div class="col-md-4">
           <div class="card border-0 shadow-sm bg-warning bg-opacity-10">
       <div class="card-body text-center">
        <i class="fas fa-exclamation-circle fa-3x text-warning mb-2"></i>
  <h3 class="mb-0">@Model.TotalItemCount</h3>
        <p class="mb-0 text-muted">Pagos Pendientes</p>
     </div>
     </div>
 </div>
  <div class="col-md-4">
       <div class="card border-0 shadow-sm bg-danger bg-opacity-10">
  <div class="card-body text-center">
       <i class="fas fa-dollar-sign fa-3x text-danger mb-2"></i>
       <h3 class="mb-0">@Model.Sum(p => p.Monto).ToString("C")</h3>
    <p class="mb-0 text-muted">Total Pendiente</p>
      </div>
   </div>
      </div>
  <div class="col-md-4">
   <div class="card border-0 shadow-sm bg-info bg-opacity-10">
   <div class="card-body text-center">
    <i class="fas fa-calendar-alt fa-3x text-info mb-2"></i>
   <h3 class="mb-0">Hoy</h3>
   <p class="mb-0 text-muted">@DateTime.Now.ToString("dd/MM/yyyy")</p>
   </div>
     </div>
 </div>
 </div>
  }

    <!-- Tabla de pagos pendientes -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
 @if (Model != null && Model.Any())
   {
   <div class="table-responsive">
  <table class="table table-hover mb-0">
     <thead class="table-warning">
       <tr>
        <th style="width: 80px;" class="text-center">
   <i class="fas fa-hashtag me-1"></i>ID
   </th>
     <th>
   <i class="fas fa-calendar me-1"></i>Fecha Generación
    </th>
   <th class="text-end">
    <i class="fas fa-dollar-sign me-1"></i>Monto
      </th>
      <th>
       <i class="fas fa-user me-1"></i>Huésped
     </th>
  <th>
       <i class="fas fa-door-open me-1"></i>Habitación
</th>
   <th>
  <i class="fas fa-calendar-check me-1"></i>Check-in
  </th>
      <th class="text-center" style="width: 200px;">
  <i class="fas fa-cog me-1"></i>Acciones
       </th>
   </tr>
</thead>
     <tbody>
    @foreach (var pago in Model)
    {
   <tr class="table-warning">
   <td class="text-center fw-bold text-danger">#@pago.Id</td>
      <td>
    <small>@pago.FechaPago.ToString("dd/MM/yyyy")</small><br/>
    <small class="text-muted">@pago.FechaPago.ToString("HH:mm")</small>
        </td>
     <td class="text-end fw-bold text-danger">
   @pago.Monto.ToString("C")
    </td>
        <td>@pago.NombreHuesped</td>
               <td>
    <span class="badge bg-info text-dark">
    #@pago.NumeroHabitacion
      </span>
 </td>
         <td>
      <small class="text-muted">Ver detalles</small>
               </td>
<td class="text-center">

     <div class="btn-group btn-group-sm" role="group">
    <a asp-action="Details" 
     asp-route-id="@pago.Id" 
    class="btn btn-outline-info" 
     title="Ver Detalles">
      <i class="fas fa-eye"></i>
       </a>
  <a asp-action="Registrar" 
      asp-route-id="@pago.IdReserva" 
    class="btn btn-success" 
      title="Registrar Pago">
      <i class="fas fa-check-circle me-1"></i>Pagar
  </a>
   </div>
       </td>
     </tr>
      }
    </tbody>
    </table>
      </div>

   <!-- Paginación -->
    @if (Model.PageCount > 1)
    {
   <div class="card-footer bg-white border-top">
        <div class="d-flex justify-content-between align-items-center">
   <div class="text-muted">
        <small>
Mostrando @Model.FirstItemOnPage - @Model.LastItemOnPage de @Model.TotalItemCount pagos pendientes
    </small>
</div>
 <nav>
      @Html.PagedListPager(Model, 
     pagina => Url.Action("Pendientes", new { pagina }),
    new PagedListRenderOptions
        {
  LiElementClasses = new[] { "page-item" },
  PageClasses = new[] { "page-link" },
    UlElementClasses = new[] { "pagination", "mb-0" },
     DisplayLinkToFirstPage = PagedListDisplayMode.Always,
       DisplayLinkToLastPage = PagedListDisplayMode.Always,
  LinkToFirstPageFormat = "Primera",
   LinkToLastPageFormat = "Última",
    LinkToPreviousPageFormat = "Anterior",
       LinkToNextPageFormat = "Siguiente"
     })
     </nav>
   </div>
     </div>
  }
    }
     else
   {
 <div class="text-center py-5">
       <i class="fas fa-check-circle fa-4x text-success mb-3"></i>
   <h5 class="text-success">¡Excelente! No hay pagos pendientes</h5>
      <p class="text-muted">Todos los pagos están al día.</p>
       <a asp-action="Index" class="btn btn-primary">
  <i class="fas fa-list me-2"></i>Ver Todos los Pagos
 </a>
 </div>
   }
 </div>
    </div>
</div>
