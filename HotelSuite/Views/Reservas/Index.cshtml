@model X.PagedList.IPagedList<HotelSuite.Application.DTOs.ReservaDTO>
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Gestión de Reservas";
}

<div class="container-fluid py-4">
    <!-- Encabezado -->
    <div class="row mb-4">
  <div class="col-12">
 <div class="card border-0 shadow-sm">
   <div class="card-body bg-gradient" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
      <div class="d-flex justify-content-between align-items-center">
    <div class="text-white">
  <h2 class="mb-1">
       <i class="fas fa-calendar-check me-2"></i>Reservas
   </h2>
        <p class="mb-0 opacity-75">Gestión de reservas del hotel</p>
    </div>
      <a asp-action="Create" class="btn btn-light btn-lg shadow-sm">
     <i class="fas fa-plus-circle me-2"></i>Nueva Reserva
  </a>
    </div>
     </div>
        </div>
   </div>
</div>

    <!-- Mensajes de feedback -->
    @if (TempData["Success"] != null)
    {
 <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
    <i class="fas fa-check-circle me-2"></i>
  @TempData["Success"]
       <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
 </div>
    }

    @if (TempData["Error"] != null)
    {
     <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
   <i class="fas fa-exclamation-circle me-2"></i>
   @TempData["Error"]
   <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    }

    <!-- Filtros de búsqueda -->
<div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-0 pt-3">
     <h5 class="mb-0">
        <i class="fas fa-search me-2 text-primary"></i>Búsqueda y Filtros
   </h5>
 </div>
   <div class="card-body">
   <form asp-action="Index" method="get" class="row g-3">
    <div class="col-md-10">
        <label for="busquedaEstado" class="form-label fw-bold">Estado de la Reserva</label>
  <div class="input-group">
      <span class="input-group-text"><i class="fas fa-info-circle"></i></span>
        <input type="text" 
     class="form-control" 
       id="busquedaEstado" 
        name="busquedaEstado" 
value="@ViewBag.BusquedaEstado" 
    placeholder="Ej: Confirmada, Cancelada, Completada...">
     </div>
     </div>
  <div class="col-md-2 d-flex align-items-end gap-2">
  <button type="submit" class="btn btn-primary flex-fill">
     <i class="fas fa-search me-1"></i>Buscar
        </button>
     <a asp-action="Index" class="btn btn-outline-secondary">
     <i class="fas fa-redo"></i>
 </a>
     </div>
  </form>
   </div>
</div>

    <!-- Tabla de reservas -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
 @if (Model != null && Model.Any())
   {
       <div class="table-responsive">
      <table class="table table-hover mb-0">
   <thead class="table-light">
        <tr>
     <th style="width: 80px;" class="text-center">
        <i class="fas fa-hashtag me-1"></i>ID
         </th>
    <th>
<i class="fas fa-user me-1"></i>Huésped
     </th>
      <th>
 <i class="fas fa-door-open me-1"></i>Habitación
  </th>
    <th class="text-center">
           <i class="fas fa-calendar me-1"></i>Check-in
       </th>
  <th class="text-center">
<i class="fas fa-calendar me-1"></i>Check-out
        </th>
    <th class="text-center">
      <i class="fas fa-moon me-1"></i>Noches
     </th>
    <th class="text-center">
    <i class="fas fa-info-circle me-1"></i>Estado
      </th>
      <th class="text-center" style="width: 200px;">
     <i class="fas fa-cog me-1"></i>Acciones
   </th>
        </tr>
     </thead>
      <tbody>
    @foreach (var reserva in Model)
           {
        <tr>
      <td class="text-center fw-bold text-primary">#@reserva.Id</td>
     <td>@reserva.NombreHuesped</td>
   <td>
<span class="badge bg-info text-dark">
           #@reserva.NumeroHabitacion - @reserva.TipoHabitacion
       </span>
    </td>
        <td class="text-center">
    <small>@reserva.FechaEntrada.ToString("dd/MM/yyyy")</small>
   </td>
      <td class="text-center">
      <small>@reserva.FechaSalida.ToString("dd/MM/yyyy")</small>
      </td>
        <td class="text-center">
    <span class="badge bg-secondary">@reserva.DiasEstancia</span>
        </td>
       <td class="text-center">
      @{
   var estadoBadge = reserva.Estado.ToLower() switch
      {
    var e when e.Contains("confirmada") => "success",
 var e when e.Contains("cancelada") => "danger",
var e when e.Contains("completada") => "primary",
        var e when e.Contains("pendiente") => "warning",
       _ => "secondary"
  };
   }
      <span class="badge bg-@estadoBadge">@reserva.Estado</span>
    </td>
    <td class="text-center">
       <div class="btn-group btn-group-sm" role="group">
    <a asp-action="Details" 
         asp-route-id="@reserva.Id" 
     class="btn btn-outline-info" 
      title="Ver Detalles">
       <i class="fas fa-eye"></i>
     </a>
         <a asp-action="Edit" 
        asp-route-id="@reserva.Id" 
         class="btn btn-outline-warning" 
    title="Editar">
        <i class="fas fa-edit"></i>
      </a>
 @if (reserva.Estado != "Cancelada")
       {
        <a asp-action="Cancel" 
       asp-route-id="@reserva.Id" 
     class="btn btn-outline-danger" 
       title="Cancelar">
 <i class="fas fa-ban"></i>
      </a>
   }
        </div>
       </td>
    </tr>
   }
     </tbody>
     </table>
    </div>

      <!-- Paginación -->
     @if (Model.PageCount > 1)
   {
     <div class="card-footer bg-white border-top">
   <div class="d-flex justify-content-between align-items-center">
   <div class="text-muted">
      <small>
   Mostrando @Model.FirstItemOnPage - @Model.LastItemOnPage de @Model.TotalItemCount reservas
      </small>
   </div>
       <nav>
      @Html.PagedListPager(Model, 
     pagina => Url.Action("Index", new { 
pagina, 
    busquedaEstado = ViewBag.BusquedaEstado 
   }),
    new PagedListRenderOptions
        {
     LiElementClasses = new[] { "page-item" },
        PageClasses = new[] { "page-link" },
      UlElementClasses = new[] { "pagination", "mb-0" },
 DisplayLinkToFirstPage = PagedListDisplayMode.Always,
      DisplayLinkToLastPage = PagedListDisplayMode.Always,
     LinkToFirstPageFormat = "Primera",
        LinkToLastPageFormat = "Última",
      LinkToPreviousPageFormat = "Anterior",
       LinkToNextPageFormat = "Siguiente"
   })
        </nav>
        </div>
   </div>
     }
   }
  else
        {
        <div class="text-center py-5">
      <i class="fas fa-calendar-times fa-4x text-muted mb-3"></i>
       <h5 class="text-muted">No se encontraron reservas</h5>
     <p class="text-muted">Intente con otros criterios de búsqueda o cree una nueva reserva.</p>
    <a asp-action="Create" class="btn btn-primary">
       <i class="fas fa-plus-circle me-2"></i>Crear Primera Reserva
     </a>
 </div>
        }
 </div>
    </div>
</div>
