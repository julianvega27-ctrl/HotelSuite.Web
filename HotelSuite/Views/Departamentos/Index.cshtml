@model X.PagedList.IPagedList<HotelSuite.Application.DTOs.DepartamentoDTO>
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "Gestión de Departamentos";
}

<div class="container-fluid py-4">
    <!-- Encabezado -->
    <div class="row mb-4">
  <div class="col-12">
            <div class="card border-0 shadow-sm">
 <div class="card-body bg-gradient" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
         <div class="d-flex justify-content-between align-items-center">
       <div class="text-white">
        <h2 class="mb-1">
        <i class="fas fa-briefcase me-2"></i>Departamentos
        </h2>
           <p class="mb-0 opacity-75">Gestión de departamentos del hotel</p>
       </div>
    <a asp-action="Create" class="btn btn-light btn-lg shadow-sm">
            <i class="fas fa-plus-circle me-2"></i>Nuevo Departamento
       </a>
</div>
                </div>
        </div>
        </div>
    </div>

    <!-- Mensajes -->
 @if (TempData["Success"] != null)
    {
     <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
      <i class="fas fa-check-circle me-2"></i>
         @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
   <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
  <i class="fas fa-exclamation-circle me-2"></i>
@TempData["Error"]
       <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
 }

    <!-- Búsqueda -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white border-0 pt-3">
 <h5 class="mb-0">
   <i class="fas fa-search me-2 text-primary"></i>Búsqueda
            </h5>
        </div>
        <div class="card-body">
   <form asp-action="Index" method="get" class="row g-3">
       <div class="col-md-10">
       <label for="busqueda" class="form-label fw-bold">Buscar Departamento</label>
        <div class="input-group">
          <span class="input-group-text"><i class="fas fa-search"></i></span>
             <input type="text" 
       class="form-control" 
                id="busqueda" 
             name="busqueda" 
 value="@ViewBag.Busqueda" 
                   placeholder="Nombre o descripción...">
          </div>
             </div>
        <div class="col-md-2 d-flex align-items-end gap-2">
            <button type="submit" class="btn btn-primary flex-fill">
              <i class="fas fa-search me-1"></i>Buscar
      </button>
   <a asp-action="Index" class="btn btn-outline-secondary">
      <i class="fas fa-redo"></i>
       </a>
                </div>
          </form>
        </div>
    </div>

    <!-- Departamentos Predefinidos -->
    @if (Model != null && Model.Any())
    {
     <div class="row row-cols-1 row-cols-md-3 g-4 mb-4">
  @foreach (var departamento in Model.Take(3))
            {
       <div class="col">
        <div class="card border-0 shadow-sm h-100 hover-card">
 <div class="card-body text-center p-4">
           @{
          var icono = departamento.Nombre.ToLower() switch
  {
   var n when n.Contains("limpieza") => "fa-broom",
   var n when n.Contains("mantenimiento") => "fa-tools",
var n when n.Contains("recepción") || n.Contains("recepcion") => "fa-concierge-bell",
          _ => "fa-briefcase"
    };
      var color = departamento.Nombre.ToLower() switch
    {
         var n when n.Contains("limpieza") => "success",
             var n when n.Contains("mantenimiento") => "warning",
       var n when n.Contains("recepción") || n.Contains("recepcion") => "info",
     _ => "primary"
               };
         }
       <div class="mb-3">
        <i class="fas @icono fa-4x text-@color"></i>
      </div>
   <h4 class="card-title">@departamento.Nombre</h4>
        <p class="card-text text-muted">@departamento.Descripcion</p>
               <div class="d-flex gap-2 justify-content-center mt-3">
          <a asp-action="Details" asp-route-id="@departamento.Id" class="btn btn-outline-info btn-sm">
          <i class="fas fa-eye me-1"></i>Ver
             </a>
 <a asp-action="Edit" asp-route-id="@departamento.Id" class="btn btn-outline-warning btn-sm">
  <i class="fas fa-edit me-1"></i>Editar
         </a>
   <a asp-controller="TareasDepartamento" asp-action="Index" asp-route-idDepartamento="@departamento.Id" class="btn btn-outline-primary btn-sm">
             <i class="fas fa-tasks me-1"></i>Tareas
       </a>
    </div>
        </div>
      </div>
  </div>
    }
        </div>
    }

    <!-- Tabla de todos los departamentos -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
        @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
 <table class="table table-hover mb-0">
            <thead class="table-light">
    <tr>
           <th style="width: 80px;" class="text-center">
       <i class="fas fa-hashtag me-1"></i>ID
     </th>
     <th>
  <i class="fas fa-briefcase me-1"></i>Nombre
         </th>
       <th>
    <i class="fas fa-align-left me-1"></i>Descripción
      </th>
                 <th class="text-center" style="width: 200px;">
          <i class="fas fa-cog me-1"></i>Acciones
         </th>
    </tr>
    </thead>
            <tbody>
          @foreach (var departamento in Model)
         {
          <tr>
                  <td class="text-center fw-bold text-primary">#@departamento.Id</td>
           <td>
     <strong>@departamento.Nombre</strong>
              </td>
           <td>@departamento.Descripcion</td>
         <td class="text-center">
         <div class="btn-group btn-group-sm" role="group">
     <a asp-action="Details" 
         asp-route-id="@departamento.Id" 
          class="btn btn-outline-info" 
                title="Ver Detalles">
    <i class="fas fa-eye"></i>
             </a>
       <a asp-action="Edit" 
          asp-route-id="@departamento.Id" 
             class="btn btn-outline-warning" 
          title="Editar">
       <i class="fas fa-edit"></i>
        </a>
         <a asp-action="Delete" 
   asp-route-id="@departamento.Id" 
               class="btn btn-outline-danger" 
     title="Eliminar">
            <i class="fas fa-trash"></i>
         </a>
       <a asp-controller="TareasDepartamento" 
     asp-action="Index" 
        asp-route-idDepartamento="@departamento.Id" 
        class="btn btn-outline-primary" 
            title="Ver Tareas">
      <i class="fas fa-tasks"></i>
       </a>
</div>
 </td>
            </tr>
     }
      </tbody>
          </table>
                </div>

          <!-- Paginación -->
      @if (Model.PageCount > 1)
          {
   <div class="card-footer bg-white border-top">
              <div class="d-flex justify-content-between align-items-center">
          <div class="text-muted">
        <small>
          Mostrando @Model.FirstItemOnPage - @Model.LastItemOnPage de @Model.TotalItemCount departamentos
    </small>
     </div>
     <nav>
@Html.PagedListPager(Model, 
           pagina => Url.Action("Index", new { pagina, busqueda = ViewBag.Busqueda }),
         new PagedListRenderOptions
            {
                LiElementClasses = new[] { "page-item" },
          PageClasses = new[] { "page-link" },
         UlElementClasses = new[] { "pagination", "mb-0" },
       DisplayLinkToFirstPage = PagedListDisplayMode.Always,
  DisplayLinkToLastPage = PagedListDisplayMode.Always,
          LinkToFirstPageFormat = "Primera",
         LinkToLastPageFormat = "Última",
      LinkToPreviousPageFormat = "Anterior",
         LinkToNextPageFormat = "Siguiente"
           })
            </nav>
   </div>
        </div>
       }
            }
            else
       {
         <div class="text-center py-5">
      <i class="fas fa-briefcase fa-4x text-muted mb-3"></i>
         <h5 class="text-muted">No se encontraron departamentos</h5>
     <p class="text-muted">Cree los departamentos principales del hotel.</p>
   <a asp-action="Create" class="btn btn-primary">
        <i class="fas fa-plus-circle me-2"></i>Crear Primer Departamento
            </a>
      </div>
     }
        </div>
    </div>
</div>

<style>
    .hover-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .hover-card:hover {
    transform: translateY(-10px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.2) !important;
    }
</style>
