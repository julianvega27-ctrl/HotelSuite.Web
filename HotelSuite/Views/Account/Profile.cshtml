@{
    ViewData["Title"] = "Mi Perfil";
    var user = ViewBag.User as HotelSuite.Domain.Entities.ApplicationUser;
    var roles = ViewBag.Roles as IList<string>;
}

<div class="container-fluid py-4">
    <!-- Encabezado -->
    <div class="row mb-4">
<div class="col-12">
      <div class="card border-0 shadow-sm">
     <div class="card-body bg-gradient" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
  <div class="text-white">
   <h2 class="mb-1">
         <i class="fas fa-user-circle me-2"></i>Mi Perfil
     </h2>
 <p class="mb-0 opacity-75">Información de tu cuenta</p>
 </div>
      </div>
</div>
</div>
    </div>

  <!-- Información del usuario -->
    <div class="row">
 <div class="col-md-8">
   <div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0">
    <h5 class="mb-0">
            <i class="fas fa-id-card me-2 text-primary"></i>Datos Personales
      </h5>
       </div>
   <div class="card-body">
        <table class="table table-borderless">
      <tbody>
      <tr>
     <td class="text-muted" style="width: 200px;">
       <i class="fas fa-user me-2"></i>Nombre Completo
         </td>
         <td><strong>@user?.NombresCompletos</strong></td>
  </tr>
     <tr>
        <td class="text-muted">
      <i class="fas fa-envelope me-2"></i>Email
    </td>
      <td><strong>@user?.Email</strong></td>
    </tr>
       <tr>
    <td class="text-muted">
       <i class="fas fa-phone me-2"></i>Teléfono
      </td>
 <td><strong>@user?.PhoneNumber</strong></td>
        </tr>
   <tr>
    <td class="text-muted">
  <i class="fas fa-calendar-alt me-2"></i>Fecha de Registro
   </td>
         <td><strong>@user?.FechaRegistro.ToString("dd/MM/yyyy HH:mm")</strong></td>
        </tr>
   <tr>
      <td class="text-muted">
    <i class="fas fa-toggle-on me-2"></i>Estado
     </td>
  <td>
 @if (user?.EstaActivo == true)
 {
  <span class="badge bg-success">Activo</span>
      }
     else
     {
       <span class="badge bg-danger">Inactivo</span>
     }
        </td>
     </tr>
    </tbody>
      </table>
 </div>
  </div>
        </div>

 <div class="col-md-4">
     <!-- Roles -->
         <div class="card border-0 shadow-sm mb-4">
 <div class="card-header bg-white border-0">
  <h5 class="mb-0">
          <i class="fas fa-user-tag me-2 text-success"></i>Roles Asignados
  </h5>
 </div>
   <div class="card-body">
       @if (roles != null && roles.Any())
  {
   <ul class="list-unstyled mb-0">
    @foreach (var role in roles)
       {
        <li class="mb-2">
    <span class="badge bg-primary bg-gradient p-2">
        <i class="fas fa-shield-alt me-1"></i>@role
           </span>
     </li>
           }
    </ul>
       }
        else
{
    <p class="text-muted mb-0">No tienes roles asignados.</p>
    }
     </div>
       </div>

            <!-- Avatar -->
            <div class="card border-0 shadow-sm">
    <div class="card-body text-center">
<div class="mb-3">
            <i class="fas fa-user-circle fa-5x text-primary"></i>
     </div>
  <h5>@user?.NombresCompletos</h5>
      <p class="text-muted mb-0">@user?.Email</p>
        </div>
    </div>
  </div>
    </div>
</div>
