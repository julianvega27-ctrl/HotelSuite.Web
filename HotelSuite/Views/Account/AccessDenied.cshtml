@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="container py-5">
    <div class="row justify-content-center">
<div class="col-md-8">
     <div class="card border-0 shadow-lg">
    <div class="card-body text-center p-5">
    <div class="mb-4">
      <i class="fas fa-ban fa-5x text-danger"></i>
 </div>
  <h1 class="display-4 text-danger mb-3">Acceso Denegado</h1>
   <p class="lead text-muted mb-4">
    No tienes permisos para acceder a esta página.
 </p>
 <p class="text-muted mb-4">
           Si crees que esto es un error, por favor contacta al administrador del sistema.
   </p>
   <div class="d-flex justify-content-center gap-3">
     <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg">
  <i class="fas fa-home me-2"></i>Ir al Inicio
    </a>
   <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-secondary btn-lg" onclick="event.preventDefault(); document.getElementById('logout-form').submit();">
            <i class="fas fa-sign-out-alt me-2"></i>Cerrar Sesión
 </a>
         </div>

<form id="logout-form" asp-controller="Account" asp-action="Logout" method="post" class="d-none">
        </form>
      </div>
   </div>

        <div class="mt-4 text-center">
    <p class="text-muted">
     <i class="fas fa-info-circle me-2"></i>
  Usuario actual: <strong>@User.Identity?.Name</strong>
 </p>
  @if (User.Identity?.IsAuthenticated == true)
  {
      <p class="text-muted">
   <i class="fas fa-user-tag me-2"></i>
       Roles: <strong>@string.Join(", ", User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value))</strong>
         </p>
          }
  </div>
     </div>
    </div>
</div>

<style>
    .card {
  border-radius: 20px;
    }

    .btn-lg {
 border-radius: 10px;
       padding: 12px 30px;
   }

    .gap-3 {
   gap: 1rem;
    }
</style>
