@model HotelSuite.Application.DTOs.HotelDTO

@{
    ViewData["Title"] = "Detalles del Hotel";
}

<div class="container">
    <div class="row justify-content-center">
       <div class="col-md-8">
       <div class="card shadow-lg">
          <div class="card-header bg-info text-white">
          <div class="d-flex justify-content-between align-items-center">
    <h4 class="mb-0"><i class="fas fa-hotel me-2"></i>Detalles del Hotel</h4>
             <span class="badge bg-warning text-dark">
     @for (int i = 0; i < Model.Categoria; i++)
         {
        <i class="fas fa-star"></i>
         }
   </span>
        </div>
     </div>
   
          <div class="card-body p-4">
    <div class="row g-4">
    <!-- Nombre -->
    <div class="col-12">
            <div class="detail-item">
          <div class="d-flex align-items-center mb-2">
         <i class="fas fa-building text-primary fa-lg me-3"></i>
     <h5 class="mb-0">Nombre del Hotel</h5>
              </div>
              <p class="ms-5 mb-0 fs-5 fw-bold">@Model.Nombre</p>
</div>
  </div>

   <!-- Dirección -->
           <div class="col-12">
           <div class="detail-item">
    <div class="d-flex align-items-center mb-2">
      <i class="fas fa-map-marker-alt text-danger fa-lg me-3"></i>
            <h5 class="mb-0">Dirección</h5>
   </div>
          <p class="ms-5 mb-0">@Model.Direccion</p>
              </div>
  </div>

<!-- Teléfono -->
   <div class="col-md-6">
           <div class="detail-item">
        <div class="d-flex align-items-center mb-2">
<i class="fas fa-phone text-success fa-lg me-3"></i>
     <h5 class="mb-0">Teléfono</h5>
          </div>
             <p class="ms-5 mb-0">@Model.Telefono</p>
               </div>
    </div>

              <!-- Categoría -->
<div class="col-md-6">
           <div class="detail-item">
      <div class="d-flex align-items-center mb-2">
      <i class="fas fa-star text-warning fa-lg me-3"></i>
           <h5 class="mb-0">Categoría</h5>
    </div>
        <p class="ms-5 mb-0">
        @Model.Categoria @(Model.Categoria == 1 ? "Estrella" : "Estrellas")
     </p>
           </div>
       </div>
     </div>

     <!-- Información Adicional -->
   <div class="row mt-4">
    <div class="col-12">
   <div class="alert alert-info">
               <h6 class="alert-heading">
      <i class="fas fa-info-circle me-2"></i>Información
     </h6>
    <ul class="mb-0">
        <li>ID del Hotel: <strong>@Model.Id</strong></li>
       <li>Estado: <span class="badge bg-success">Activo</span></li>
        </ul>
      </div>
  </div>
          </div>
            </div>

   <div class="card-footer bg-light">
      <div class="d-flex gap-2">
           <a asp-action="Index" class="btn btn-secondary">
 <i class="fas fa-arrow-left me-2"></i>Volver al Listado
      </a>
  @if (User.IsInRole("Administrador") || User.IsInRole("Gerente"))
       {
     <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
    <i class="fas fa-edit me-2"></i>Editar
       </a>
    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
    <i class="fas fa-trash me-2"></i>Eliminar
  </a>
         }
    </div>
     </div>
   </div>
        </div>
    </div>
</div>

<style>
    .detail-item {
   padding: 1rem;
        background: #f8f9fa;
        border-radius: 10px;
        border-left: 4px solid #667eea;
}

    .detail-item:hover {
      background: #e9ecef;
    transition: all 0.3s;
    }
</style>
