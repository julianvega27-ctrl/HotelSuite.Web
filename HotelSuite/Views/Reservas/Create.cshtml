@model HotelSuite.Application.DTOs.ReservaDTO

@{
    ViewData["Title"] = "Nueva Reserva";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Encabezado -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body bg-gradient text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h3 class="mb-1">
                        <i class="fas fa-calendar-plus me-2"></i>Registrar Nueva Reserva
                    </h3>
                    <p class="mb-0 opacity-75">Complete la información para crear una reserva</p>
                </div>
            </div>

            <!-- Formulario -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" id="formReserva">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="row g-4">
                            <!-- Sección: Información del Huésped -->
                            <div class="col-12">
                                <h5 class="border-bottom pb-2 mb-3">
                                    <i class="fas fa-user me-2 text-primary"></i>Información del Huésped
                                </h5>
                            </div>

                            <!-- Huésped -->
                            <div class="col-12">
                                <label asp-for="IdHuesped" class="form-label fw-bold">
                                    <i class="fas fa-user me-1 text-primary"></i>Huésped
                                </label>
                                <div class="input-group input-group-lg">
                                    <select asp-for="IdHuesped"
                                            class="form-select"
                                            asp-items="@ViewBag.Huespedes"
                                            id="selectHuesped">
                                        <option value="">-- Seleccione un huésped --</option>
                                    </select>
                                    <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalNuevoHuesped" title="Registrar nuevo huésped">
                                        <i class="fas fa-user-plus me-1"></i>Nuevo Huésped
                                    </button>
                                </div>
                                <span asp-validation-for="IdHuesped" class="text-danger small"></span>
                                <small class="text-muted d-block mt-1">
                                    <i class="fas fa-info-circle me-1"></i>Si el huésped no aparece, use el botón "Nuevo Huésped"
                                </small>
                            </div>

                            <!-- Sección: Información de la Habitación -->
                            <div class="col-12 mt-4">
                                <h5 class="border-bottom pb-2 mb-3">
                                    <i class="fas fa-door-open me-2 text-primary"></i>Información de la Habitación
                                </h5>
                            </div>

                            <!-- Habitación -->
                            <div class="col-12">
                                <label asp-for="IdHabitacion" class="form-label fw-bold">
                                    <i class="fas fa-bed me-1 text-primary"></i>Habitación Disponible
                                </label>

                                @if (ViewBag.NoHabitacionesDisponibles == true)
                                {
                                    <div class="alert alert-warning">
                                        <i class="fas fa-exclamation-triangle me-2"></i>
                                        <strong>No hay habitaciones disponibles</strong>
                                        <p class="mb-2 mt-2">Actualmente todas las habitaciones están ocupadas o reservadas.</p>
                                        <p class="mb-0">
                                            <strong>Opciones:</strong>
                                        </p>
                                        <ul class="mb-0">
                                            <li>Espere a que haya disponibilidad</li>
                                            <li>Cancele una reserva existente en <a asp-controller="Reservas" asp-action="Index" class="alert-link">Gestión de Reservas</a></li>
                                            <li>Agregue más habitaciones en <a asp-controller="Habitaciones" asp-action="Create" class="alert-link">Nueva Habitación</a></li>
                                        </ul>
                                    </div>
                                    <select asp-for="IdHabitacion" class="form-select" asp-items="ViewBag.Habitaciones" disabled>
                                        <option value="">No hay habitaciones disponibles</option>
                                    </select>
                                }
                                else
                                {
                                    <select asp-for="IdHabitacion" class="form-select form-select-lg" asp-items="ViewBag.Habitaciones" id="selectHabitacion">
                                        <option value="">-- Seleccione una habitación --</option>
                                    </select>
                                }

                                <span asp-validation-for="IdHabitacion" class="text-danger small"></span>
                                <small class="text-muted d-block mt-1">
                                    <i class="fas fa-info-circle me-1"></i>Solo se muestran habitaciones disponibles (con hotel incluido)
                                </small>
                            </div>

                            <!-- Información de la habitación seleccionada -->
                            <div class="col-12" id="habitacionInfo" style="display: none;">
                                <div class="alert alert-info mb-0">
                                    <div class="row">
                                        <div class="col-md-3">
                                            <strong>Número:</strong> <span id="infoNumero">-</span>
                                        </div>
                                        <div class="col-md-3">
                                            <strong>Tipo:</strong> <span id="infoTipo">-</span>
                                        </div>
                                        <div class="col-md-3">
                                            <strong>Precio/Noche:</strong> <span id="infoPrecio">-</span>
                                        </div>
                                        <div class="col-md-3">
                                            <strong>Estado:</strong> <span id="infoEstado" class="badge bg-success">-</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Sección: Fechas de la Reserva -->
                            <div class="col-12 mt-4">
                                <h5 class="border-bottom pb-2 mb-3">
                                    <i class="fas fa-calendar me-2 text-primary"></i>Fechas de la Reserva
                                </h5>
                            </div>

                            <!-- Fecha de Entrada -->
                            <div class="col-md-6">
                                <label asp-for="FechaEntrada" class="form-label fw-bold">
                                    <i class="fas fa-calendar-check me-1 text-success"></i>Fecha de Entrada
                                </label>
                                <input asp-for="FechaEntrada"
                                       type="date"
                                       class="form-control form-control-lg"
                                       id="inputFechaEntrada"
                                       min="@DateTime.Now.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="FechaEntrada" class="text-danger small"></span>
                            </div>

                            <!-- Fecha de Salida -->
                            <div class="col-md-6">
                                <label asp-for="FechaSalida" class="form-label fw-bold">
                                    <i class="fas fa-calendar-times me-1 text-danger"></i>Fecha de Salida
                                </label>
                                <input asp-for="FechaSalida"
                                       type="date"
                                       class="form-control form-control-lg"
                                       id="inputFechaSalida"
                                       min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="FechaSalida" class="text-danger small"></span>
                            </div>

                            <!-- Resumen de Estancia -->
                            <div class="col-12">
                                <div class="card bg-light border-primary">
                                    <div class="card-body">
                                        <div class="row align-items-center">
                                            <div class="col-md-3 text-center border-end">
                                                <i class="fas fa-moon fa-2x text-primary mb-2"></i>
                                                <h4 class="mb-0" id="totalNoches">0</h4>
                                                <small class="text-muted">Noches</small>
                                            </div>
                                            <div class="col-md-3 text-center border-end">
                                                <i class="fas fa-dollar-sign fa-2x text-success mb-2"></i>
                                                <h4 class="mb-0" id="precioNoche">$0.00</h4>
                                                <small class="text-muted">Precio/Noche</small>
                                            </div>
                                            <div class="col-md-3 text-center border-end">
                                                <i class="fas fa-calculator fa-2x text-info mb-2"></i>
                                                <h4 class="mb-0" id="subtotal">$0.00</h4>
                                                <small class="text-muted">Subtotal</small>
                                            </div>
                                            <div class="col-md-3 text-center">
                                                <i class="fas fa-receipt fa-2x text-warning mb-2"></i>
                                                <h2 class="mb-0 text-primary fw-bold" id="montoTotal">$0.00</h2>
                                                <small class="text-muted">Total a Pagar</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Estado (oculto, valor por defecto) -->
                            <input type="hidden" asp-for="Estado" value="Confirmada" />
                            <input type="hidden" asp-for="FechaReserva" value="@DateTime.Now.ToString("yyyy-MM-dd")" />

                            <!-- Botones -->
                            <div class="col-12 mt-4">
                                <div class="d-flex gap-2 justify-content-end">
                                    <a asp-action="Index" class="btn btn-lg btn-outline-secondary">
                                        <i class="fas fa-times me-2"></i>Cancelar
                                    </a>

                                    @if (ViewBag.NoHabitacionesDisponibles == true)
                                    {
                                        <button type="button" class="btn btn-lg btn-secondary" disabled title="No hay habitaciones disponibles">
                                            <i class="fas fa-ban me-2"></i>No Disponible
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-lg btn-primary" id="btnGuardar" disabled>
                                            <i class="fas fa-save me-2"></i>Crear Reserva
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Información adicional -->
            <div class="card border-0 shadow-sm bg-light mt-4">
                <div class="card-body">
                    <h6 class="text-muted mb-2">
                        <i class="fas fa-lightbulb me-2"></i>Información Importante
                    </h6>
                    <ul class="small text-muted mb-0">
                        <li>La reserva se crea en estado "Confirmada" automáticamente</li>
                        <li>Al crear la reserva, la habitación cambiará a estado "Reservada"</li>
                        <li>Se generará automáticamente un pago pendiente por el monto total</li>
                        <li>El monto total se calcula: Noches × Precio por Noche</li>
                        <li>La fecha de entrada no puede ser anterior a hoy</li>
                        <li>La fecha de salida debe ser posterior a la fecha de entrada</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Nuevo Huésped -->
<div class="modal fade" id="modalNuevoHuesped" tabindex="-1" aria-labelledby="modalNuevoHuespedLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalNuevoHuespedLabel">
                    <i class="fas fa-user-plus me-2"></i>Registrar Nuevo Huésped
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formNuevoHuesped">
                    <div class="row g-3">
                        <!-- Nombres -->
                        <div class="col-md-6">
                            <label for="modalNombres" class="form-label fw-bold">
                                <i class="fas fa-user me-1"></i>Nombres
                            </label>
                            <input type="text" class="form-control" id="modalNombres" required maxlength="100" />
                            <div class="invalid-feedback">Los nombres son obligatorios</div>
                        </div>

                        <!-- Apellidos -->
                        <div class="col-md-6">
                            <label for="modalApellidos" class="form-label fw-bold">
                                <i class="fas fa-user me-1"></i>Apellidos
                            </label>
                            <input type="text" class="form-control" id="modalApellidos" required maxlength="100" />
                            <div class="invalid-feedback">Los apellidos son obligatorios</div>
                        </div>

                        <!-- Email -->
                        <div class="col-md-6">
                            <label for="modalEmail" class="form-label fw-bold">
                                <i class="fas fa-envelope me-1"></i>Email
                            </label>
                            <input type="email" class="form-control" id="modalEmail" required maxlength="150" />
                            <div class="invalid-feedback">Email válido obligatorio</div>
                        </div>

                        <!-- Teléfono -->
                        <div class="col-md-6">
                            <label for="modalTelefono" class="form-label fw-bold">
                                <i class="fas fa-phone me-1"></i>Teléfono
                            </label>
                            <input type="tel" class="form-control" id="modalTelefono" required maxlength="20" placeholder="+52 55 1234 5678" />
                            <div class="invalid-feedback">Teléfono obligatorio</div>
                        </div>

                        <!-- Documento de Identidad -->
                        <div class="col-12">
                            <label for="modalDocumento" class="form-label fw-bold">
                                <i class="fas fa-id-card me-1"></i>Documento de Identidad
                            </label>
                            <input type="text" class="form-control" id="modalDocumento" required maxlength="50" placeholder="DNI, Pasaporte, etc." />
                            <div class="invalid-feedback">Documento de identidad obligatorio</div>
                        </div>

                        <div class="col-12">
                            <div class="alert alert-info mb-0">
                                <i class="fas fa-info-circle me-2"></i>
                                <small>El huésped se registrará y aparecerá automáticamente en el selector de huéspedes.</small>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-2"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="btnGuardarHuesped">
                    <i class="fas fa-save me-2"></i>Guardar Huésped
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
    $(document).ready(function() {
     console.log('? Script de reservas cargado correctamente');
        
        let precioHabitacion = 0;

  // Cuando cambia la habitación seleccionada
        $('#selectHabitacion').change(function() {
var habitacionId = $(this).val();
       console.log('Habitación seleccionada:', habitacionId);

        if (habitacionId) {
        // Obtener información de la habitación via AJAX
   $.ajax({
         url: '@Url.Action("GetHabitacionInfo", "Reservas")',
      type: 'GET',
  data: { id: habitacionId },
              success: function(response) {
 console.log('? Respuesta AJAX:', response);
  if (response.success) {
  $('#infoNumero').text(response.numero);
                    $('#infoTipo').text(response.tipo);
  $('#infoPrecio').text('$' + response.precio.toFixed(2));
     $('#infoEstado').text(response.estado)
           .removeClass()
            .addClass('badge')
          .addClass(response.estado === 'Disponible' ? 'bg-success' : 'bg-warning');

         precioHabitacion = response.precio;
              $('#habitacionInfo').fadeIn();
         calcularTotal();
          } else {
        console.error('? Error en respuesta:', response.message);
       alert('Error: ' + response.message);
         }
   },
        error: function(xhr, status, error) {
          console.error('? Error AJAX:', error);
            console.error('Status Code:', xhr.status);
    console.error('Response:', xhr.responseText);
    alert('Error al cargar información de la habitación. Código: ' + xhr.status);
       }
  });
     } else {
                $('#habitacionInfo').fadeOut();
     precioHabitacion = 0;
          calcularTotal();
            }
        });

        // Cuando cambian las fechas
     $('#inputFechaEntrada, #inputFechaSalida').change(function() {
      console.log('Fechas cambiadas');
            calcularTotal();
  validarFechas();
});

        // Función para calcular el total
      function calcularTotal() {
            var fechaEntrada = new Date($('#inputFechaEntrada').val());
            var fechaSalida = new Date($('#inputFechaSalida').val());

      console.log('Calculando total. Entrada:', fechaEntrada, 'Salida:', fechaSalida, 'Precio:', precioHabitacion);

       if (fechaEntrada && fechaSalida && fechaSalida > fechaEntrada && precioHabitacion > 0) {
       var diffTime = Math.abs(fechaSalida - fechaEntrada);
         var diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));

     var subtotal = precioHabitacion * diffDays;
  var total = subtotal;

         console.log('? Cálculo: ' + diffDays + ' noches × $' + precioHabitacion + ' = $' + total);

                $('#totalNoches').text(diffDays);
          $('#precioNoche').text('$' + precioHabitacion.toFixed(2));
         $('#subtotal').text('$' + subtotal.toFixed(2));
             $('#montoTotal').text('$' + total.toFixed(2));

        validarFormulario();
     } else {
    console.log('?? No se puede calcular total. Datos incompletos.');
            $('#totalNoches').text('0');
       $('#precioNoche').text('$0.00');
          $('#subtotal').text('$0.00');
       $('#montoTotal').text('$0.00');
        $('#btnGuardar').prop('disabled', true);
            }
     }

        // Función para validar fechas
        function validarFechas() {
       var fechaEntrada = new Date($('#inputFechaEntrada').val());
     var fechaSalida = new Date($('#inputFechaSalida').val());
          var hoy = new Date();
   hoy.setHours(0, 0, 0, 0);

            if (fechaEntrada < hoy) {
                console.warn('?? Fecha de entrada anterior a hoy');
   alert('La fecha de entrada no puede ser anterior a hoy.');
    $('#inputFechaEntrada').val('');
           return false;
  }

            if (fechaSalida <= fechaEntrada) {
      console.warn('?? Fecha de salida no es posterior a entrada');
     alert('La fecha de salida debe ser posterior a la fecha de entrada.');
                $('#inputFechaSalida').val('');
  return false;
         }

  console.log('? Fechas válidas');
            return true;
   }

        // Función para validar todo el formulario
  function validarFormulario() {
     var huesped = $('#selectHuesped').val();
     var habitacion = $('#selectHabitacion').val();
          var fechaEntrada = $('#inputFechaEntrada').val();
     var fechaSalida = $('#inputFechaSalida').val();

          console.log('Validando formulario:', { huesped, habitacion, fechaEntrada, fechaSalida });

            if (huesped && habitacion && fechaEntrada && fechaSalida) {
    var entrada = new Date(fechaEntrada);
       var salida = new Date(fechaSalida);

         if (salida > entrada) {
         console.log('? Formulario válido. Habilitando botón.');
  $('#btnGuardar').prop('disabled', false)
              .removeClass('btn-secondary')
   .addClass('btn-primary');
} else {
    console.log('?? Fecha salida no es posterior a entrada');
     $('#btnGuardar').prop('disabled', true)
              .removeClass('btn-primary')
     .addClass('btn-secondary');
  }
            } else {
console.log('?? Formulario incompleto. Faltan datos.');
   $('#btnGuardar').prop('disabled', true)
         .removeClass('btn-primary')
  .addClass('btn-secondary');
    }
        }

        // Validar cuando cambia cualquier campo
        $('#selectHuesped, #selectHabitacion').change(function() {
 console.log('Campo cambiado:', this.id);
   validarFormulario();
        });

        // Actualizar fecha mínima de salida cuando cambia la entrada
        $('#inputFechaEntrada').change(function() {
       var fechaEntrada = new Date($(this).val());
   fechaEntrada.setDate(fechaEntrada.getDate() + 1);
            var minFechaSalida = fechaEntrada.toISOString().split('T')[0];
            $('#inputFechaSalida').attr('min', minFechaSalida);
            console.log('Fecha mínima de salida actualizada:', minFechaSalida);
        });

        // Confirmación antes de enviar
        $('#formReserva').submit(function(e) {
    var total = $('#montoTotal').text();
       var noches = $('#totalNoches').text();
            var huesped = $('#selectHuesped option:selected').text();
       var habitacion = $('#selectHabitacion option:selected').text();

            console.log('?? Enviando formulario...');
            console.log('Datos:', { huesped, habitacion, total, noches });

            if (!confirm(`¿Está seguro de crear esta reserva?\n\nHuésped: ${huesped}\nHabitación: ${habitacion}\nTotal: ${total}\nNoches: ${noches}\n\nSe generará un pago pendiente automáticamente.`)) {
      e.preventDefault();
        console.log('? Usuario canceló el envío');
    return false;
         }

 console.log('? Usuario confirmó. Enviando...');
            // Deshabilitar botón para evitar doble envío
        $('#btnGuardar').prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Guardando...');
        });

 // Validación inicial
 console.log('Validación inicial del formulario');
        validarFormulario();

        // ===== MODAL NUEVO HUÉSPED =====
   $('#btnGuardarHuesped').click(function() {
       console.log('?? Guardando nuevo huésped');
     
     // Validar campos del modal
       var form = $('#formNuevoHuesped')[0];
   if (!form.checkValidity()) {
         form.classList.add('was-validated');
  alert('Por favor complete todos los campos obligatorios.');
       return;
            }

 // Obtener datos del formulario
            var nuevoHuesped = {
        Nombres: $('#modalNombres').val().trim(),
    Apellidos: $('#modalApellidos').val().trim(),
  Email: $('#modalEmail').val().trim(),
         Telefono: $('#modalTelefono').val().trim(),
   DocumentoIdentidad: $('#modalDocumento').val().trim()
   };

         console.log('Datos del nuevo huésped:', nuevoHuesped);

     // Validaciones básicas
   if (!nuevoHuesped.Nombres || !nuevoHuesped.Apellidos || !nuevoHuesped.Email || 
   !nuevoHuesped.Telefono || !nuevoHuesped.DocumentoIdentidad) {
     alert('Todos los campos son obligatorios.');
            return;
       }

            // Validar formato de email
       var emailRegex = new RegExp('^[^\\s@@]+@@[^\\s@@]+\\.[^\\s@@]+$');
          if (!emailRegex.test(nuevoHuesped.Email)) {
  alert('Por favor ingrese un email válido.');
     return;
      }

   // Deshabilitar botón mientras se guarda
  var btnGuardar = $(this);
     btnGuardar.prop('disabled', true).html('<i class="fas fa-spinner fa-spin me-2"></i>Guardando...');

   // Obtener token antiforgery
   var token = $('input[name="__RequestVerificationToken"]').val();

        // Enviar via AJAX
            $.ajax({
         url: '@Url.Action("CreateAjax", "Huespedes")',
         type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(nuevoHuesped),
 headers: {
   'RequestVerificationToken': token
      },
        success: function(response) {
         console.log('? Respuesta del servidor:', response);
    
     if (response.success) {
        // Agregar el nuevo huésped al selector
         var newOption = new Option(
           response.huesped.nombreCompleto,
      response.huesped.id,
  true,
  true
    );
       $('#selectHuesped').append(newOption).trigger('change');

                    // Cerrar modal
      $('#modalNuevoHuesped').modal('hide');
    
       // Limpiar formulario
    $('#formNuevoHuesped')[0].reset();
    $('#formNuevoHuesped').removeClass('was-validated');

        // Mostrar mensaje de éxito
       toastr.success(response.message, 'Huésped Registrado');
    console.log('? Huésped agregado al selector:', response.huesped);
    
     // Validar formulario de reserva
     validarFormulario();
     } else {
       alert('Error: ' + response.message);
   console.error('? Error al guardar:', response.message);
            }
   },
  error: function(xhr, status, error) {
   console.error('? Error AJAX:', error);
               console.error('Status:', xhr.status);
      console.error('Response:', xhr.responseText);
           alert('Error al guardar el huésped. Por favor intente nuevamente.');
      },
  complete: function() {
    // Rehabilitar botón
    btnGuardar.prop('disabled', false).html('<i class="fas fa-save me-2"></i>Guardar Huésped');
            }
       });
 });

        // Limpiar formulario del modal al cerrarlo
